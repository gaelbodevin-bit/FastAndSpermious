{
  "rules": {
    "scores": {
      "$level": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "leaderboards": {
      "$level": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "leaderboard_total": {
      ".read": true,
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "players": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "premium": {
          ".write": false
        },
        "paidSkins": {
          ".write": false
        },
        "$other": {
          ".write": "$uid === auth.uid && $other !== 'premium' && $other !== 'paidSkins'"
        }
      }
    },
    "purchaseTokens": {
      ".read": false,
      ".write": false
    }
  }
}
