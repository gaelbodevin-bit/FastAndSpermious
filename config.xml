<?xml version="1.0" encoding="utf-8"?>
<widget
    id="com.fast.spermious"
    version="1.1.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <!-- =============================== -->
    <!--           APP INFO              -->
    <!-- =============================== -->
    <name>Fast and Spermious</name>

    <description>
        Fast and Spermious - arcade reflex game.
    </description>

    <author email="contact@bluecellproduction.com">
        Blue Cell Production
    </author>

    <content src="index.html" />

    <!-- =============================== -->
    <!--        NAVIGATION / ACCESS      -->
    <!-- =============================== -->
    <allow-navigation href="*" />
    <access origin="*" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- =============================== -->
    <!--        ANDROID SDK (FORCE)      -->
    <!-- =============================== -->
    <preference name="android-minSdkVersion" value="23" />
    <preference name="android-targetSdkVersion" value="35" />
    <preference name="android-compileSdkVersion" value="35" />

    <!-- =============================== -->
    <!--          GLOBAL PREFS           -->
    <!-- =============================== -->
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- DEV ONLY (mettre false en release) -->
    <preference name="AndroidWebViewDebuggingEnabled" value="true" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />

    <!-- =============================== -->
    <!--            ANDROID              -->
    <!-- =============================== -->
    <platform name="android">

        <!-- Icone app (launcher) -->
        <icon src="www/assets/studio/logo_cell.png" />

        <!-- Splash Android 12+ neutralise (l'intro HTML prend le relais) -->
        <preference name="AndroidWindowSplashScreenAnimatedIcon"
                    value="www/assets/studio/splash_icon_transparent.png" />
        <preference name="AndroidWindowSplashScreenBackground"
                    value="#0B0F10" />
        <preference name="AndroidWindowSplashScreenAnimationDuration"
                    value="0" />

    </platform>

    <!-- =============================== -->
    <!--              iOS                -->
    <!-- =============================== -->
    <platform name="ios">

        <icon src="www/assets/studio/logo_cell.png" />

        <preference name="StatusBarOverlaysWebView" value="true" />
        <preference name="StatusBarStyle" value="lightcontent" />
        <preference name="Orientation" value="portrait" />

    </platform>

    <!-- =============================== -->
    <!--            PLUGINS              -->
    <!-- =============================== -->
    <!-- Connexion Google (Firebase Auth) -->
    <plugin name="cordova-plugin-googleplus" spec="^8.5.2">
        <variable name="REVERSED_CLIENT_ID" value="com.googleusercontent.apps.791766983410-auisv28tqpmqk0qfrl6rftth5pdlou2t" />
        <variable name="WEB_APPLICATION_CLIENT_ID" value="791766983410-auisv28tqpmqk0qfrl6rftth5pdlou2t.apps.googleusercontent.com" />
    </plugin>

    <!-- Publicite interstitielle -->
    <plugin name="admob-plus-cordova" spec="^1.28.0">
        <!-- App ID de TEST Google. Remplacer par le vrai App ID AdMob avant publication. -->
        <variable name="APP_ID_ANDROID" value="ca-app-pub-3940256099942544~3347511713" />
    </plugin>

    <!-- Achats integres (premium no-ads) -->
    <plugin name="cordova-plugin-purchase" spec="^13.11.1" />

</widget>
